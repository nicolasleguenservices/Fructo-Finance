# Ce site n'utilise ni CRM (GoHighLevel) ni paiement (Stripe).

# Optionnel — améliore la qualité des logos de produits auto-récupérés par
# domaine (ProductLogo.astro). Sans cette clé, on utilise Clearbit (gratuit,
# sans clé) en repli. Voir https://logo.dev
LOGO_DEV_TOKEN=

# Site key (publique) Cloudflare Turnstile pour le CAPTCHA du formulaire de
# contact (/contact/). Sans cette clé, le widget ne s'affiche pas et le
# formulaire fonctionne normalement (pas de blocage). Voir
# https://dash.cloudflare.com/?to=/:account/turnstile pour créer un site.
# Note : c'est une clé PUBLIQUE (exposée au navigateur), safe à committer
# dans un déploiement — seule la secret key (non utilisée ici, pas de
# backend) doit rester privée.
PUBLIC_TURNSTILE_SITE_KEY=

# ─── Odoo — formulaire infolettre (fonction Cloudflare Pages functions/api/subscribe.js) ───
# À définir dans Cloudflare Pages → Settings → Variables and Secrets (PAS ici,
# ce fichier est committé). ODOO_API_KEY doit être créée comme « Secret » chiffré.
# Pour un test local : les mettre dans un fichier .dev.vars (git-ignoré) ou en
# variables d'environnement du terminal (voir scripts/odoo-test.mjs).
ODOO_URL=https://fructofinance.odoo.com
ODOO_DB=fructofinance
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_LIST_ID=

# Clé d'accès (publique) Web3Forms pour le formulaire de contact (/contact/).
# Le formulaire appelle https://api.web3forms.com/submit directement depuis le
# navigateur : leur plan gratuit refuse les appels serveur→serveur (403 "Use
# our API in client side"), d'où une clé PUBLIC_ exposée au navigateur comme
# PUBLIC_TURNSTILE_SITE_KEY — c'est le fonctionnement prévu par Web3Forms.
# Générée sur https://web3forms.com avec l'adresse de réception voulue (ex.
# fructofinance@gmail.com) : c'est cette adresse qui recevra les messages.
# À définir dans Cloudflare Pages → Settings → Variables and Secrets, comme
# variable d'environnement de BUILD (pas un secret Functions : elle doit être
# présente au moment du build pour être intégrée aux pages statiques).
PUBLIC_WEB3FORMS_KEY=

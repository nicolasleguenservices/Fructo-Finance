---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
  og_type?: string;
}

const {
  title,
  meta_title,
  description,
  image,
  noindex,
  canonical,
  og_type = "website",
} = Astro.props;
---

<!doctype html>
<html lang="fr-CA">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <!-- Impact Universal Tracking Tag -->
    <script is:inline type="text/javascript">
      (function (i, m, p, a, c, t) {
        c.ire_o = p;
        c[p] =
          c[p] ||
          function () {
            (c[p].a = c[p].a || []).push(arguments);
          };
        t = a.createElement(m);
        var z = a.getElementsByTagName(m)[0];
        t.async = 1;
        t.src = i;
        z.parentNode.insertBefore(t, z);
      })(
        "https://utt.impactcdn.com/P-A7752494-d41d-4b37-97f1-b5aea8823ee71.js",
        "script",
        "impactStat",
        document,
        window,
      );
      impactStat("transformLinks");
      impactStat("trackImpression");
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png"
    />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-name" content="automark-astro" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#fff"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#000"
    />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    {canonical && <link rel="canonical" href={canonical} item-prop="url" />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- View Transitions removed to avoid conflicts with GSAP/Lenis/Swiper -->

    <meta name="author" content={config.metadata.meta_author} />
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content={og_type} />
    <meta property="og:site_name" content={config.site.title} />
    <meta
      property="og:url"
      content={`${config.site.base_url}/${Astro.url.pathname.replace("/", "")}`}
    />
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta
      property="og:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      name="twitter:image"
      content={`${config.site.base_url}${
        image ? image : config.metadata.meta_image
      }`}
    />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- GSAP CDN -->
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/gsap.min.js"></script>
    <script
      is:inline
      defer
      src="https://cdn.jsdelivr.net/npm/gsap@3.14.1/dist/ScrollTrigger.min.js"
    ></script>

    <!-- LENIS CDN -->
    <script
      is:inline
      defer
      src="https://unpkg.com/lenis@1.3.17/dist/lenis.min.js"></script>

    <!-- Main UI interactions -->
    <script is:inline defer src="/scripts/main.js"></script>

    <!-- Animations (Modules are deferred automatically by browsers) -->
    <script is:inline type="module" src="/scripts/animations.js"></script>

    <!-- Balises additionnelles spécifiques à la page (JSON-LD, etc.) -->
    <slot name="head" />
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    {/* <TwSizeIndicator /> */}
    <Header />
    <main id="main-content" class="overflow-x-clip">
      <slot />
    </main>
    <Footer />
  </body>
</html>

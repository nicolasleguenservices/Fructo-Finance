---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import Logo from "@/layouts/components/Logo.astro";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}

const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings } = config;
const { pathname } = Astro.url;

const isActive = (url: string) => pathname === url || pathname === `${url}/`;
const isChildActive = (children?: ChildNavigationLink[]) =>
  !!children?.some((child) => isActive(child.url));

const ctaEnabled = navigation_button.enable;
const ctaTarget = navigation_button.link.startsWith("http")
  ? "_blank"
  : "_self";
const ctaRel = navigation_button.link.startsWith("http")
  ? "noopener noreferrer"
  : undefined;
---

<header
  id="site-header"
  class:list={["header", settings.sticky_header && "header-sticky"]}
>
  <nav class="navbar container" aria-label="Navigation principale">
    <Logo width={108} height={40} loading="eager" />

    <div id="nav-collapse" class="nav-collapse">
      <ul id="nav-menu" class="nav-menu">
        <span id="nav-cursor" class="nav-cursor" aria-hidden="true"></span>
        {
        main.map((item) =>
          item.hasChildren ? (
            <li class="nav-item nav-dropdown">
              <button
                type="button"
                class:list={[
                  "nav-link nav-dropdown-toggle",
                  isChildActive(item.children) && "active",
                ]}
                aria-haspopup="true"
                aria-expanded="false"
              >
                {item.name}
                <svg class="nav-caret" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z" />
                </svg>
              </button>
              <ul class="nav-dropdown-list">
                {item.children?.map((child) => (
                  <li>
                    <a
                      href={child.url}
                      class:list={[
                        "nav-dropdown-link",
                        isActive(child.url) && "active",
                      ]}
                      aria-current={isActive(child.url) ? "page" : undefined}
                    >
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li class="nav-item">
              <a
                href={item.url}
                class:list={["nav-link", isActive(item.url) && "active"]}
                aria-current={isActive(item.url) ? "page" : undefined}
              >
                {item.name}
              </a>
            </li>
          ),
        )
      }
      {
        ctaEnabled && (
          <li class="nav-cta-mobile">
            <a
              class="btn btn-primary"
              href={navigation_button.link}
              target={ctaTarget}
              rel={ctaRel}
            >
              {navigation_button.label}
            </a>
          </li>
        )
      }
      </ul>
    </div>

    <div class="navbar-actions">
      {
        ctaEnabled && (
          <a
            class="btn btn-primary nav-cta"
            href={navigation_button.link}
            target={ctaTarget}
            rel={ctaRel}
          >
            {navigation_button.label}
          </a>
        )
      }
      <button
        id="nav-toggle"
        type="button"
        class="nav-toggle-btn"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </nav>
</header>

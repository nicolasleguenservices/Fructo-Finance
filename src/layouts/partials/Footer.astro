---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import Logo from "@/layouts/components/Logo.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Menu } from "@/types";

const {
  footer_primary,
  footer_resource,
  footer_legal,
  footer_col_1_title,
  footer_col_2_title,
  footer_col_3_title,
} = menu as Menu;
---

<footer class="section pb-0 relative overflow-hidden">
  <div class="container pb-10">
    <div
      class="flex flex-col gap-y-10 md:grid md:grid-cols-[minmax(0,1fr)_auto_auto_auto] md:items-start md:gap-x-6 md:gap-y-0 lg:flex lg:flex-row lg:flex-wrap lg:justify-between lg:gap-x-10 lg:gap-y-10"
    >
      <!-- Column 1 - Logo & Contact -->
      <div
        class="max-w-95 mb-10 text-lg text-text md:mb-0 md:max-w-none lg:mb-20 lg:max-w-95"
      >
        <Logo class="inline-block" />
        <p class="mt-6">{config.params.footer_tagline}</p>
        {
          config.params.footer_email && (
            <a
              class="link mt-6 inline-block underline"
              href={`mailto:${config.params.footer_email}`}
            >
              {config.params.footer_email}
            </a>
          )
        }
        {
          config.params.footer_phone && (
            <a class="link mt-4 block" href={`tel:${config.params.footer_phone}`}>
              {config.params.footer_phone}
            </a>
          )
        }
      </div>
      <!-- Column 2 - Primary -->
      <div>
        <h3 class="footer-label">{footer_col_1_title}</h3>
        <ul>
          {
            footer_primary?.map((item) => (
              <li class="mb-5">
                <a href={item.url} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- Column 3 - Resource -->
      <div>
        <h3 class="footer-label">{footer_col_2_title}</h3>
        <ul>
          {
            footer_resource?.map((item) => (
              <li class="mb-5">
                <a href={item.url} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- Column 4 - Legal -->
      <div>
        <h3 class="footer-label">{footer_col_3_title}</h3>
        <ul>
          {
            footer_legal?.map((item) => (
              <li class="mb-5">
                <a href={item.url} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <!-- Bottom Area -->
  <hr
    class="h-px bg-linear-to-r from-transparent from-25% via-border to-75% to-transparent border-0"
  />
  <div class="container py-7">
    <p
      class="text-base text-text"
      set:html={markdownify(config.params.copyright)}
    />
  </div>

  <div
    class="absolute bottom-0 left-1/2 size-280 blur-2xl -translate-x-1/2 translate-y-1/2 -z-10"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent) 0%, transparent 80%);"
  >
  </div>
</footer>

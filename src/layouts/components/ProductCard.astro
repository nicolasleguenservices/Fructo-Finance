---
import type { Product } from "@/data/types";
import Rating from "./Rating.astro";
import AffiliateButton from "./AffiliateButton.astro";
import ProductLogo from "./ProductLogo.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
---

<article
  class="flex flex-col gap-4 rounded-2xl border border-border bg-body p-6 shadow-sm"
>
  <header class="flex items-center gap-4">
    <ProductLogo product={product} size={44} />
    <div>
      <h3 class="mb-1 text-lg font-bold text-secondary">{product.name}</h3>
      <Rating rating={product.rating} />
    </div>
  </header>

  <p class="m-0 text-text-dark">{product.resume}</p>

  <ul class="stars-list m-0 text-sm text-text">
    {product.highlights.map((highlight) => <li>{highlight}</li>)}
  </ul>

  <footer class="mt-auto pt-2">
    <AffiliateButton
      affiliate={product.affiliate}
      label={`Ouvrir un compte ${product.name}`}
      class="w-full text-center"
    />
  </footer>
</article>

---
import ImageMod from "@/layouts/components/ImageMod.astro";

interface Props {
  image: string;
  imageAlt: string;
  /** "contain" pour une image qui ne doit pas être rognée (ex. composition avec logos). */
  imageFit?: "cover" | "contain";
  title: string;
  description: string;
  author: string;
  authorImage: string;
  date: string;
  readTime: string;
  pillarLabel: string;
  pillarUrl: string;
  href: string;
}

const {
  image,
  imageAlt,
  imageFit = "cover",
  title,
  description,
  author,
  authorImage,
  date,
  readTime,
  pillarLabel,
  pillarUrl,
  href,
} = Astro.props;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-body"
>
  <a href={href} class="block shrink-0 overflow-hidden bg-secondary">
    <ImageMod
      src={image}
      alt={imageAlt}
      width={600}
      height={340}
      fit={imageFit}
      position="left"
      loading="lazy"
      class:list={[
        "aspect-[600/340] h-auto w-full object-left transition-transform duration-300 hover:scale-[1.03]",
        imageFit === "contain" ? "object-contain" : "object-cover",
      ]}
    />
  </a>

  <div class="flex h-full flex-col gap-3 p-6">
    <a
      href={pillarUrl}
      class="w-fit rounded-full bg-secondary/8 px-2.5 py-0.5 text-xs font-semibold text-secondary hover:bg-secondary hover:text-white"
    >
      {pillarLabel}
    </a>

    <h2 class="text-h5-sm md:text-h5 text-secondary">
      <a href={href} class="hover:text-primary hover:underline">{title}</a>
    </h2>

    <p class="text-sm leading-6 text-text">{description}</p>

    <div
      class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-border pt-4 text-xs text-text-dark"
    >
      <span class="inline-flex items-center gap-1.5">
        <ImageMod
          src={authorImage}
          alt={author}
          width={20}
          height={20}
          fit="cover"
          class="size-5 rounded-full"
        />
        {author}
      </span>
      <span>{date}</span>
      <span>{readTime}</span>
    </div>
  </div>
</article>

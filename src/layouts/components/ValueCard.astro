---
import ImageMod from "@/layouts/components/ImageMod.astro";
interface Props {
  logo: string;
  title: string;
  list?: string[];
}
const { logo, title, list } = Astro.props;
---

<div class="p-8 rounded-2xl bg-light border border-border">
  <div class="mb-6 size-14 rounded-xl bg-secondary grid place-items-center">
    <ImageMod src={logo} alt={`${title} icon`} class="size-7" />
  </div>
  <h3 class="text-h5-sm font-bold">{title}</h3>
  <ul class="stars-list mt-5 text-text-dark">
    {list?.map((item) => <li>{item}</li>)}
  </ul>
</div>

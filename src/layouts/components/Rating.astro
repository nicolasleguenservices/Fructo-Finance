---
interface Props {
  rating: number;
  max?: number;
}

const { rating, max = 5 } = Astro.props;
const clamped = Math.max(0, Math.min(rating, max));
const percentage = (clamped / max) * 100;
---

<span
  class="inline-flex items-center gap-2 text-sm"
  role="img"
  aria-label={`Note : ${clamped} sur ${max}`}
>
  <span
    class="relative inline-block leading-none text-lg tracking-wider"
    aria-hidden="true"
  >
    <span class="text-border">★★★★★</span>
    <span
      class="absolute inset-0 overflow-hidden whitespace-nowrap text-primary"
      style={`width: ${percentage}%`}>★★★★★</span
    >
  </span>
  <span class="font-semibold text-text-dark">{clamped.toFixed(1)} / {max}</span
  >
</span>

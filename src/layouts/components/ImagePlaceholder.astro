---
/**
 * Placeholder « Image à venir » — fond bleu nuit, ratio fixe.
 * À remplacer par un vrai visuel (<ImageMod />) une fois disponible.
 * On conserve width/height + alt pour ne pas casser la mise en page ni l'accessibilité.
 */
interface Props {
  /** Texte alternatif décrivant l'image finale attendue. */
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { alt, width = 1200, height = 900, class: className } = Astro.props;
---

<figure
  class:list={[
    "relative flex flex-col items-center justify-center gap-3 overflow-hidden rounded-[16px] bg-secondary text-center",
    className,
  ]}
  style={`aspect-ratio: ${width} / ${height}`}
  role="img"
  aria-label={alt}
>
  <svg
    width="40"
    height="40"
    viewBox="0 0 24 24"
    fill="none"
    stroke="var(--color-yellow)"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <rect x="3" y="3" width="18" height="18" rx="2"></rect>
    <circle cx="8.5" cy="8.5" r="1.5"></circle>
    <path d="M21 15l-5-5L5 21"></path>
  </svg>
  <figcaption class="px-4 font-secondary text-sm font-semibold text-white/80">
    Image à venir
  </figcaption>
</figure>

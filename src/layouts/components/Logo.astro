---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

interface Props {
  src?: string;
  /** Surcharge de logo_width/logo_height (config), ex. pour une taille propre au header. */
  width?: number | string;
  height?: number | string;
  /** Surcharge la classe du lien englobant (par défaut : style header). */
  class?: string;
  /** "eager" pour le logo du header (au-dessus de la ligne de flottaison) ; "lazy" ailleurs (footer). */
  loading?: "eager" | "lazy";
}

const {
  src,
  width,
  height,
  class: wrapperClass = "navbar-brand inline-block",
  loading = "lazy",
} = Astro.props as Props;

const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const w = String(width ?? logo_width).replace("px", "");
const h = String(height ?? logo_height).replace("px", "");
---

<a href="/" class={wrapperClass}>
  {
    src || logo ? (
      <ImageMod
        src={src ? src : logo}
        class="inline-block"
        width={Number(w) * 2}
        height={Number(h) * 2}
        alt={title}
        loading={loading}
        style={{
          height: `${h}px`,
          width: `${w}px`,
        }}
        format="webp"
      />
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>

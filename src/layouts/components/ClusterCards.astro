---
import { getProductsByCluster } from "@/data/products";
import ProductLogo from "./ProductLogo.astro";

const investirProducts = getProductsByCluster("investir");

const clusters = [
  {
    href: "/investir",
    title: "Investir",
    description:
      "Comparez les courtiers en ligne pour votre CELI, REER ou CELIAPP.",
    icon: ["M23 6l-9.5 9.5-5-5L1 18", "M17 6h6v6"],
    dark: true,
  },
  {
    href: "/cartes-credit",
    title: "Cartes de crédit",
    description:
      "Trouvez la carte adaptée à vos habitudes : remises, voyage, sans frais annuels.",
    icon: ["M1 4h22v4H1z", "M1 10h22v10a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V10z", "M5 16h4"],
    dark: false,
  },
  {
    href: "/epargne",
    title: "Épargne",
    description:
      "Comparez les comptes d'épargne à intérêt élevé et les solutions bancaires en ligne.",
    icon: ["M19 12a7 7 0 1 1-7-7", "M19 5l-7 7", "M14 5h5v5"],
    dark: false,
  },
];
---

<section class="section">
  <div class="container">
    <div class="section-intro centralize mb-12">
      <h2 class="title hasHighlight">Les trois univers Finance Québec</h2>
    </div>
    <div class="grid gap-8 md:grid-cols-2">
      {
        clusters.map((cluster) => (
          <a
            href={cluster.href}
            class:list={[
              "group relative flex flex-col gap-2 overflow-hidden rounded-2xl border p-8 transition-all duration-300",
              cluster.dark
                ? "border-transparent bg-secondary text-white md:row-span-2"
                : "border-border bg-body text-text hover:border-primary/50",
            ]}
          >
            <span
              class:list={[
                "inline-flex size-11 items-center justify-center rounded-full",
                cluster.dark ? "bg-white/10 text-white" : "bg-light text-secondary",
              ]}
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5.5"
                aria-hidden="true"
              >
                {cluster.icon.map((d) => (
                  <path d={d} />
                ))}
              </svg>
            </span>
            <h3
              class:list={[
                "mt-1 text-xl font-bold",
                cluster.dark ? "text-white" : "text-secondary",
              ]}
            >
              {cluster.title}
            </h3>
            <p
              class:list={[
                "m-0",
                cluster.dark ? "text-white/75" : "text-text-dark",
              ]}
            >
              {cluster.description}
            </p>

            {cluster.dark && investirProducts.length > 0 && (
              <div class="mt-4 flex items-baseline gap-2">
                <span class="font-secondary text-4xl font-bold text-white">
                  {investirProducts.length}
                </span>
                <span class="text-sm text-white/75">courtiers comparés</span>
              </div>
            )}
            {cluster.dark && investirProducts.length > 0 && (
              <div class="mt-auto flex flex-wrap gap-3 pt-4">
                {investirProducts.slice(0, 6).map((product) => (
                  <ProductLogo product={product} size={32} />
                ))}
              </div>
            )}

            <span
              class:list={[
                "mt-2 font-semibold",
                cluster.dark ? "text-yellow" : "text-primary",
              ]}
            >
              Explorer →
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import ComparisonTable from "@/layouts/components/ComparisonTable.astro";
import ProductCard from "@/layouts/components/ProductCard.astro";
import AffiliateDisclosure from "@/layouts/components/AffiliateDisclosure.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Accordion from "@/layouts/components/Accordion.astro";
import { getProductsByClusterRanked } from "@/data/products";
import { clusterContent } from "@/data/cluster-content";
import type { ClusterId } from "@/data/types";

interface Props {
  cluster: ClusterId;
}

const { cluster } = Astro.props;
const products = getProductsByClusterRanked(cluster);
const content = clusterContent[cluster];
---

<Base
  title={content.heroTitle}
  meta_title={content.metaTitle}
  description={content.metaDescription}
>
  <PageHeader title={content.heroTitle} subtitle={content.heroIntro} />

  <!-- Divulgation d'affiliation (bandeau visible avant le comparatif) -->
  <section class="pt-0 pb-10 md:pb-14">
    <div class="container">
      <AffiliateDisclosure compact />
    </div>
  </section>

  <!-- Comparatif -->
  <section class="section pt-0">
    <div class="container">
      <div class="section-intro centralize mb-10">
        <h2 class="title hasHighlight">Comparatif</h2>
      </div>
      <ComparisonTable products={products} />
    </div>
  </section>

  <!-- Cartes produit -->
  <section class="section pt-0">
    <div class="container">
      <div class="section-intro centralize mb-10">
        <h2 class="title hasHighlight">Nos avis détaillés</h2>
      </div>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <!-- Sections pédagogiques -->
  {
    content.pedagogicalSections.length > 0 && (
      <section class="section pt-0">
        <div class="container">
          <div class="content mx-auto max-w-220">
            {content.pedagogicalSections.map((sectionItem) => (
              <div id={sectionItem.id}>
                <h2>{sectionItem.heading}</h2>
                {sectionItem.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ -->
  {
    content.faqs.length > 0 && (
      <section class="section pt-0">
        <div class="container">
          <div class="section-intro centralize mb-10">
            <h2 class="title hasHighlight">Questions fréquentes</h2>
          </div>
          <div class="mx-auto max-w-220 space-y-4">
            {content.faqs.map((item) => (
              <Accordion title={item.question} content={item.answer} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Call to Action -->
  <CallToAction />
</Base>

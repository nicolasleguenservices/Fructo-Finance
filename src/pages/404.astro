---
import Base from "@/layouts/Base.astro";

const clusters = [
  { href: "/investir", label: "Investir" },
  { href: "/cartes-credit", label: "Cartes de crédit" },
  { href: "/epargne", label: "Épargne" },
];
---

<Base
  title="Page introuvable"
  meta_title="Page introuvable (404) | Finance Québec"
  description="Cette page n'existe pas ou plus. Retrouvez nos comparatifs sur l'investissement, les cartes de crédit et l'épargne."
  noindex
>
  <section class="section-ph text-center relative overflow-hidden">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>

      <div class="row justify-center">
        <div class="sm:col-10 md:col-8 lg:col-6">
          <span class="text-[8rem] block font-bold text-primary"> 404 </span>
          <h1 class="h2 mb-4">Page introuvable</h1>
          <div class="content">
            <p>
              La page que vous cherchez n'existe pas ou a été déplacée. Voici
              où continuer :
            </p>
          </div>
          <div class="flex flex-wrap justify-center gap-4 mt-8">
            <a href="/" class="btn btn-primary">Retour à l'accueil</a>
            {
              clusters.map((cluster) => (
                <a href={cluster.href} class="btn btn-outline">
                  {cluster.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
  </section>
</Base>

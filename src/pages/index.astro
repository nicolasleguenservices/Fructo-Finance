---
import Base from "@/layouts/Base.astro";
import ClusterCards from "@/layouts/components/ClusterCards.astro";
import ProcessCard from "@/layouts/components/ProcessCard.astro";
import BlogCard from "@/layouts/components/BlogCard.astro";
import Faq from "@/layouts/components/Faq.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import VideoShowcase from "@/layouts/components/VideoShowcase.astro";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import frenchDate from "@/lib/utils/frenchDate";
import readingTime from "@/lib/utils/readingTime";
import { getAuthor } from "@/data/authors";
import { markdownify } from "@/lib/utils/textConverter";
import config from "@/config/config.json";
import type { Homepage, FaqSection } from "@/types";

const pillarMeta = {
  investir: { label: "Investir", url: "/investir" },
  "cartes-credit": { label: "Cartes de crédit", url: "/cartes-credit" },
  epargne: { label: "Épargne", url: "/epargne" },
} as const;

const homepage = await getListPage("homepage", "-index");
const homepageData: Homepage = homepage.data;

const faqEntry = await getListPage("faqSection", "faq");
const faqData: FaqSection = faqEntry.data;

const latestPosts = (await getSinglePage("blog"))
  .sort((a, b) => b.data.datePublished.valueOf() - a.data.datePublished.valueOf())
  .slice(0, 3);

const pageTitle = "Comparateur de produits financiers au Québec | Fructo Finance";
const pageDescription =
  "Comparez gratuitement les meilleurs courtiers en ligne, cartes de crédit et comptes d'épargne offerts au Québec. Comparatifs indépendants, en français, à jour.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: config.site.title,
    url: config.site.base_url,
    logo: `${config.site.base_url}${config.site.logo}`,
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: config.site.title,
    url: config.site.base_url,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqData.items.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.answer,
      },
    })),
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Banner -->
  <section class="section-ph pt-24 md:pt-32 relative overflow-hidden">
    <div class="container relative">
      <div class="absolute top-0 left-0 w-full">
        <div class="h-100 w-full overflow-hidden -translate-y-10">
          <canvas class="heroSporeCanvas w-full"></canvas>
        </div>
      </div>
      <div class="row justify-center">
        <div class="mb-20 text-center relative">
          <h1
            class="mb-8 lg:col-9 mx-auto text-h3 lg:text-h1"
            set:html={markdownify(homepageData.banner.title)}
          />
          <p class="mb-10 lg:col-6 mx-auto">{homepageData.banner.content}</p>
          <div class="flex gap-4 justify-center items-center flex-wrap">
            <a
              class="btn btn-primary"
              rel="noopener noreferrer"
              href={homepageData.banner.button_primary.link}
            >
              {homepageData.banner.button_primary.label}
            </a>
            <a
              class="btn btn-outline"
              rel="noopener noreferrer"
              href={homepageData.banner.button_secondary.link}
            >
              {homepageData.banner.button_secondary.label}
            </a>
          </div>
        </div>
        <div class="col-12">
          <div
            class="flex justify-center w-full perspective-near xl:perspective-dramatic"
          >
            <VideoShowcase />
          </div>
        </div>
      </div>
    </div>
    <div
      class="absolute left-1/2 top-0 -translate-y-1/2 -translate-x-1/2 size-160 xl:size-300 -z-20 blur-2xl"
      style="background: radial-gradient(circle, var(--color-primary) 0%, color-mix(in srgb, var(--color-primary) 78%, transparent) 20%, transparent 70%);"
    >
    </div>
    <div class="absolute top-0 left-0 flex flex-col gap-6 -z-10">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="567"
        height="558"
        fill="none"
      >
        <g opacity=".5">
          <g filter="url(#a-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#b-banner)"
              d="M-20.527-7.51 10.182-43l259.774 233.148-13.283 15.352-277.2-213.01Z"
            ></path></g
          >
          <g filter="url(#c-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#d-banner)"
              d="M-52 13.659-20.788-25l267.328 224.459-13.502 16.722-285.04-202.522Z"
            ></path></g
          >
          <g filter="url(#e-banner)" style="mix-blend-mode:plus-lighter"
            ><path
              fill="url(#f-banner)"
              d="M-108.079-4.9-66.125-46l290.011 307.352-18.147 17.779-313.818-284.03Z"
            ></path></g
          >
          <g filter="url(#g-banner)"
            ><ellipse
              cx="143"
              cy="252.378"
              fill="var(--color-primary-light)"
              fill-opacity=".5"
              rx="143"
              ry="252.378"
              transform="scale(-1 1) rotate(46.133 191.203 -117.756)"
            ></ellipse></g
          >
        </g>
        <defs>
          <filter
            id="a-banner"
            width="338.484"
            height="296.5"
            x="-44.527"
            y="-67"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="c-banner"
            width="346.541"
            height="289.181"
            x="-76.001"
            y="-49"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="e-banner"
            width="379.965"
            height="373.131"
            x="-132.079"
            y="-70"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="12"></feGaussianBlur></filter
          >
          <filter
            id="g-banner"
            width="914.454"
            height="906.103"
            x="-348.178"
            y="-349.061"
            color-interpolation-filters="sRGB"
            filterUnits="userSpaceOnUse"
            ><feFlood flood-opacity="0" result="BackgroundImageFix"
            ></feFlood><feBlend
              in="SourceGraphic"
              in2="BackgroundImageFix"
              result="shape"></feBlend><feGaussianBlur
              result="effect1"
              stdDeviation="125"></feGaussianBlur></filter
          >
          <linearGradient
            id="b-banner"
            x1="-5.173"
            x2="258.744"
            y1="-25.255"
            y2="203.106"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
          <linearGradient
            id="d-banner"
            x1="-36.394"
            x2="235.144"
            y1="-5.671"
            y2="213.574"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
          <linearGradient
            id="f-banner"
            x1="-87.102"
            x2="208.568"
            y1="-25.45"
            y2="276.359"
            gradientUnits="userSpaceOnUse"
            ><stop stop-color="var(--color-primary)"></stop><stop
              offset="1"
              stop-color="var(--color-primary)"
              stop-opacity="0"></stop></linearGradient
          >
        </defs>
      </svg>
    </div>
  </section>
  <hr
    class="h-px bg-linear-to-r from-transparent from-10% via-border to-90% to-transparent border-0"
  />

  <!-- Barre de confiance -->
  {
    homepageData.main_features.enable && (
      <section class="section-ph py-10">
        <div class="container">
          <div class="flex flex-wrap items-center justify-center gap-4">
            {homepageData.main_features.items.map((text: string) => (
              <div class="bg-body border border-border px-4 py-2.5 rounded-full flex items-center justify-center gap-x-2">
                <svg
                  class="shrink-0"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="var(--color-secondary)"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle cx="12" cy="12" r="9.5" stroke-width="1.5" />
                  <path d="M8 12.5l2.5 2.5L16 9.5" />
                </svg>
                <span class="font-semibold text-secondary text-base">
                  {text}
                </span>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Les 3 univers -->
  <ClusterCards />

  <!-- Passage ancré (SEO) -->
  {
    homepageData.testimonial_quote.enable && (
      <section class="section">
        <div class="container">
          <div class="section-intro centralize mb-12">
            <h2
              class="title hasHighlight"
              set:html={markdownify(homepageData.testimonial_quote.title)}
            />
          </div>
          <div class="max-w-[1000px] mx-auto flex flex-col md:flex-row md:items-stretch gap-8 xl:gap-12">
            <div
              class="relative w-full md:w-[42%] md:shrink-0 h-60 sm:h-72 md:h-auto bg-secondary rounded-2xl overflow-hidden"
            >
              <img
                src="/images/comparateur-produits-financiers-quebec.webp"
                alt="Équipe comparant des produits financiers au Québec"
                width="1200"
                height="800"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 size-full object-cover"
              />
            </div>
            <div class="md:flex-1">
              <p class="text-text leading-[1.7]">
                {homepageData.testimonial_quote.quote}
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Comment nous comparons -->
  {
    homepageData.growth_process.enable && (
      <section class="section bg-light">
        <div class="container">
          <div class="section-container">
            <div class="section-intro centralize">
              <h2
                class="title hasHighlight  "
                set:html={markdownify(homepageData.growth_process.title)}
              />
              {homepageData.growth_process.subtitle && (
                <p class="subtitle text-text-dark">
                  {homepageData.growth_process.subtitle}
                </p>
              )}
            </div>
            <div class="section-content">
              <div class="grid lg:grid-cols-2 xl:grid-cols-3 gap-8 xl:gap-16">
                {homepageData.growth_process.items.map((item: any) => (
                  <ProcessCard
                    icon={item.logo}
                    title={item.title}
                    content={item.content}
                  />
                ))}
              </div>
              {homepageData.growth_process.disclosure && (
                <p class="mt-10 xl:mt-14 text-center text-sm text-text-dark max-w-160 mx-auto">
                  {homepageData.growth_process.disclosure}
                </p>
              )}
              {homepageData.growth_process.button.enable && (
                <div class="flex justify-center mt-10 xl:mt-18">
                  <a
                    href={homepageData.growth_process.button.link}
                    class="btn btn-primary"
                  >
                    {homepageData.growth_process.button.label}
                  </a>
                </div>
              )}
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Nos derniers guides -->
  {
    latestPosts.length > 0 && (
      <section class="section overflow-hidden">
        <div class="container relative isolate">
          <div class="section-intro centralize mb-12">
            <h2 class="title hasHighlight">Nos derniers guides</h2>
            <p class="subtitle">
              Des guides pratiques pour comprendre et choisir vos produits
              financiers au Québec.
            </p>
          </div>

          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {latestPosts.map((post) => {
              const author = getAuthor(post.data.author);
              const pillar = pillarMeta[post.data.pillar];
              return (
                <BlogCard
                  image={post.data.coverImage}
                  imageAlt={post.data.coverAlt}
                  imageFit={post.data.coverFit}
                  title={post.data.title}
                  description={post.data.description}
                  author={author.name}
                  authorImage={author.image}
                  date={frenchDate(post.data.datePublished)}
                  readTime={readingTime(post.body ?? "")}
                  pillarLabel={pillar.label}
                  pillarUrl={pillar.url}
                  href={`/blog/${post.data.slug ?? post.id}`}
                />
              );
            })}
          </div>

          <div class="flex justify-center mt-12">
            <a href="/blog" class="btn btn-outline">
              Voir tous les articles
            </a>
          </div>

          <div class="pointer-events-none absolute left-1/2 top-1/2 -z-10 size-310.5 -translate-x-1/2 -translate-y-1/3 rounded-full bg-radial from-primary/16 from-0% to-transparent to-70% blur-2xl" />
        </div>
      </section>
    )
  }

  <Faq />

  <!-- CTA final -->
  <CallToAction>
    <a href="/cartes-credit" class="btn btn-outline">
      Cartes de crédit
    </a>
    <a href="/epargne" class="btn btn-outline">
      Épargne
    </a>
  </CallToAction>

  <!-- Capture courriel -->
  <section class="section">
    <div
      class="container bg-secondary text-text-light py-16 rounded-4xl relative overflow-hidden isolate"
    >
      <div class="section-container">
        <div class="section-intro centralize">
          <h2 class="title text-text-light lg:col-8">
            Recevez les meilleures offres par courriel
          </h2>
          <p class="subtitle text-text-light/75 lg:col-6">
            Comparatifs, bonus de bienvenue et mises à jour importantes, une
            fois par mois, pas plus.
          </p>
          <form
            id="newsletter-form"
            class="mt-9 w-full max-w-120 mx-auto"
          >
            <div class="flex flex-wrap items-center justify-center gap-3">
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="Votre adresse courriel"
                class="flex-1 min-w-60 rounded-full border border-transparent bg-light px-5 py-3 text-text placeholder:text-text-dark focus:outline-none focus:border-primary"
              />
              {/* Champ piège anti-bot : masqué aux humains, ignoré s'il est rempli. */}
              <input
                type="text"
                name="company"
                tabindex="-1"
                autocomplete="off"
                aria-hidden="true"
                class="hidden"
              />
              <button type="submit" class="btn btn-primary">
                M'inscrire
              </button>
            </div>
            <label
              class="mt-4 flex items-start gap-2 text-left text-sm text-text-light/70"
            >
              <input
                type="checkbox"
                name="consent"
                required
                class="mt-0.5 shrink-0"
              />
              <span>
                J'accepte de recevoir l'infolettre de Fructo Finance (comparatifs
                et offres). Je peux me désabonner à tout moment via le lien
                présent dans chaque courriel.
              </span>
            </label>
            <p
              id="newsletter-status"
              role="status"
              aria-live="polite"
              class="mt-3 text-sm"
              hidden
            >
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>
  <script>
    const form = document.getElementById("newsletter-form");
    const statusEl = document.getElementById("newsletter-status");

    if (form && statusEl) {
      const setStatus = (message, ok) => {
        statusEl.textContent = message;
        statusEl.classList.toggle("text-green-300", ok === true);
        statusEl.classList.toggle("text-red-300", ok === false);
        statusEl.classList.toggle("text-text-light/60", ok === undefined);
        statusEl.hidden = false;
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const data = Object.fromEntries(new FormData(form).entries());
        const submitBtn = form.querySelector('button[type="submit"]');

        setStatus("Envoi en cours…", undefined);
        submitBtn?.setAttribute("disabled", "true");

        try {
          const res = await fetch("/api/subscribe", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              email: String(data.email || ""),
              consent: data.consent === "on",
              company: String(data.company || ""),
            }),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok && body.ok) {
            setStatus(body.message || "Merci, vous êtes inscrit !", true);
            form.reset();
          } else {
            setStatus(
              body.error || "L'inscription a échoué. Réessayez plus tard.",
              false,
            );
          }
        } catch {
          setStatus(
            "Erreur réseau. Vérifiez votre connexion et réessayez.",
            false,
          );
        } finally {
          submitBtn?.removeAttribute("disabled");
        }
      });
    }
  </script>
</Base>

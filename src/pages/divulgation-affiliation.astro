---
import Base from "@/layouts/Base.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";

// État actuel (voir products.json) : aucun produit n'a affiliate.rel === "sponsored",
// donc aucun lien de ce site n'est un vrai lien d'affiliation rémunéré. Le contenu
// ci-dessous doit rester honnête sur ce point.
//
// Pour réactiver la version "programme d'affiliation actif" le jour venu : repasser
// `affiliate.rel` à "sponsored" pour les produits concernés dans products.json, puis
// restaurer/adapter le texte antérieur de cette page (voir son historique git) — et
// faire de même dans src/layouts/components/AffiliateDisclosure.astro,
// src/pages/a-propos.astro, src/content/sections/faq.md et
// src/content/homepage/-index.md.
---

<Base
  title="Divulgation d'affiliation"
  meta_title="Divulgation d'affiliation"
  description="Comment Fructo Finance fonctionne et comment nous sommes financés, en toute transparence."
>
  <PageHeader
    title="Divulgation d'affiliation"
    subtitle="Comment Fructo Finance est financé, en toute transparence."
  />

  <section class="section pt-0">
    <div class="container">
      <div class="content mx-auto max-w-220">
        <p>
          Fructo Finance est un site indépendant. Voici comment il fonctionne
          aujourd'hui, en toute transparence.
        </p>

        <h2>Comment nous sommes financés actuellement</h2>
        <p>
          En ce moment, les liens vers les courtiers, cartes de crédit et
          comptes d'épargne présentés sur ce site mènent directement aux sites
          officiels des institutions. Ce ne sont pas des liens d'affiliation :
          nous ne recevons actuellement aucune commission lorsque vous ouvrez
          un compte ou faites une demande via ces liens.
        </p>

        <h2>Notre engagement d'indépendance</h2>
        <p>
          Nos notes, nos classements et le contenu de nos avis reposent
          uniquement sur les caractéristiques réelles des produits (frais,
          taux, conditions, comptes offerts), vérifiées à la source. Cela ne
          changera pas si des partenariats commerciaux voient le jour : nous
          ne recommanderons jamais un produit uniquement parce qu'il nous
          rémunère.
        </p>

        <h2>Et si cela change ?</h2>
        <p>
          Si Fructo Finance met un jour en place de vrais liens d'affiliation
          rémunérés, cette page sera mise à jour pour l'indiquer clairement,
          et les liens concernés porteront l'attribut
          <code>rel="sponsored"</code>, conformément aux recommandations de
          Google pour la divulgation des liens commerciaux.
        </p>

        <h2>Des questions ?</h2>
        <p>
          Pour toute question sur notre fonctionnement, <a href="/contact">contactez-nous</a
          >.
        </p>
      </div>
    </div>
  </section>
</Base>

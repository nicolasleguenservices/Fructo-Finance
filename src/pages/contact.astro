---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import Faq from "@/layouts/components/Faq.astro";
import PageHeader from "@/layouts/components/PageHeader.astro";
import { getListPage } from "@/lib/contentParser.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import type { Contact } from "@/types";

const contact = await getListPage("contact", "-index");
const contactData: Contact = contact.data;
const hasContactInfo =
  contactData.contact_info?.enable &&
  (contactData.contact_info.items.length ?? 0) > 0;

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<Base {...contactData}>
  <PageHeader
    title={contactData.page_header!.title}
    subtitle={contactData.page_header!.subtitle}
  />

  <!-- Contact Section -->
  <section class="section pt-0">
    <div class="container">
      <div class="row g-7 max-lg:gap-5">
        <!-- Left Column - Contact Cards -->
        {
          hasContactInfo && (
            <div class="col-12 lg:col-5">
              <div class="flex flex-col gap-5">
                {contactData.contact_info!.items.map((item) => {
                  const href =
                    item.link ||
                    (item.type === "email"
                      ? `mailto:${item.detail}`
                      : item.type === "phone"
                        ? `tel:${item.detail}`
                        : undefined);

                  return (
                    <a
                      href={href}
                      class="flex flex-col gap-5 p-7 md:p-8 bg-light border border-border rounded-2xl cursor-pointer hover:border-primary/50 transition-all duration-300 group hover:scale-[1.02]"
                    >
                      <div class="w-10 h-10 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                        <DynamicIcon
                          icon={item.icon ?? ""}
                          className="w-10 h-10 text-primary"
                        />
                      </div>
                      <div class="flex flex-col gap-3">
                        <h3 class="font-secondary font-bold text-2xl text-secondary">
                          {item.title}
                        </h3>
                        <p class="text-text text-lg">{item.detail}</p>
                      </div>
                    </a>
                  );
                })}
              </div>
            </div>
          )
        }

        <!-- Right Column - Contact Form -->
        <div class:list={["col-12", hasContactInfo ? "lg:col-7" : "lg:col-8 lg:mx-auto"]}>
          <div class="p-8 md:p-10 bg-light border border-border rounded-2xl">
            <form
              id="contact-form"
              class="flex flex-col gap-10"
            >
              <div class="flex flex-col gap-5">
                <div class="relative">
                  <input
                    type="text"
                    name="name"
                    placeholder="Nom"
                    required
                    class="w-full rounded-full bg-light px-8 py-5 border border-border text-text placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors"
                  />
                </div>
                <div class="relative">
                  <input
                    type="email"
                    name="email"
                    placeholder="Adresse courriel"
                    required
                    class="w-full rounded-full bg-light px-8 py-5 border border-border text-text placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors"
                  />
                </div>
                <div class="relative">
                  <input
                    type="tel"
                    name="phone"
                    placeholder="Téléphone (optionnel)"
                    class="w-full rounded-full bg-light px-8 py-5 border border-border text-text placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors"
                  />
                </div>
                <div class="relative">
                  <textarea
                    name="message"
                    placeholder="Votre message..."
                    rows={4}
                    required
                    class="w-full rounded-[20px] bg-light px-8 py-5 border border-border text-text placeholder:text-text-dark focus:border-primary focus:outline-none transition-colors resize-none"
                  ></textarea>
                </div>
                {/* Champ piège anti-bot : masqué aux humains, ignoré s'il est rempli. */}
                <input
                  type="text"
                  name="botcheck"
                  tabindex="-1"
                  autocomplete="off"
                  aria-hidden="true"
                  class="hidden"
                />
              </div>
              {
                turnstileSiteKey && (
                  <div class="flex flex-col items-center gap-2">
                    <div id="turnstile-widget" />
                    <p
                      id="turnstile-fallback-note"
                      class="hidden text-sm text-text-dark"
                    >
                      La vérification anti-robot n'a pas pu se charger ; vous
                      pouvez tout de même envoyer votre message.
                    </p>
                  </div>
                )
              }
              <div class="flex flex-col gap-6">
                <button
                  type="submit"
                  id="contact-submit"
                  disabled={Boolean(turnstileSiteKey)}
                  class="btn btn-primary w-full py-4 text-lg font-medium disabled:cursor-not-allowed disabled:opacity-50"
                >
                  Envoyer le message
                </button>
                <p
                  id="contact-status"
                  role="status"
                  aria-live="polite"
                  class="text-sm"
                  hidden
                >
                </p>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    // Rendu explicite (plutôt qu'implicite via data-sitekey) : on garde le
    // contrôle exact de l'ordre d'exécution pour éviter une course entre le
    // script Turnstile (chargé en async) et la définition de nos callbacks.
    // Scripts is:inline volontairement (pas de type="module") pour rester
    // synchrones et s'exécuter avant que le script externe async ne charge.
    turnstileSiteKey && (
      <script
        is:inline
        set:html={`
          function turnstileEnableSubmit() {
            var btn = document.getElementById("contact-submit");
            if (btn) btn.removeAttribute("disabled");
          }
          function turnstileFallback() {
            var note = document.getElementById("turnstile-fallback-note");
            if (note) note.classList.remove("hidden");
            turnstileEnableSubmit();
          }
          window.onTurnstileReady = function () {
            window.turnstile.render("#turnstile-widget", {
              sitekey: ${JSON.stringify(turnstileSiteKey)},
              callback: turnstileEnableSubmit,
              "expired-callback": function () {
                var btn = document.getElementById("contact-submit");
                if (btn) btn.setAttribute("disabled", "true");
              },
              "error-callback": turnstileFallback,
            });
          };
          // Filet de sécurité : si le script Turnstile est bloqué (bloqueur
          // de pub, réseau, etc.) et ne s'est jamais initialisé, ne pas
          // garder le formulaire bloqué indéfiniment pour un visiteur
          // légitime.
          setTimeout(function () {
            if (!window.turnstile) turnstileFallback();
          }, 5000);
        `}
      />
    )
  }
  {
    turnstileSiteKey && (
      <script
        is:inline
        src="https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onTurnstileReady&render=explicit"
        async
        defer
      />
    )
  }

  <script>
    const form = document.getElementById("contact-form");
    const statusEl = document.getElementById("contact-status");

    if (form && statusEl) {
      const setStatus = (message, ok) => {
        statusEl.textContent = message;
        statusEl.classList.toggle("text-green-600", ok === true);
        statusEl.classList.toggle("text-red-600", ok === false);
        statusEl.classList.toggle("text-text-dark", ok === undefined);
        statusEl.hidden = false;
      };

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const data = Object.fromEntries(new FormData(form).entries());
        const submitBtn = form.querySelector('button[type="submit"]');

        setStatus("Envoi en cours…", undefined);
        submitBtn?.setAttribute("disabled", "true");

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({
              name: String(data.name || ""),
              email: String(data.email || ""),
              phone: String(data.phone || ""),
              message: String(data.message || ""),
              botcheck: String(data.botcheck || ""),
            }),
          });
          const body = await res.json().catch(() => ({}));

          if (res.ok && body.ok) {
            setStatus(body.message || "Merci, votre message a été envoyé !", true);
            form.reset();
          } else {
            setStatus(
              body.error || "L'envoi a échoué. Réessayez plus tard.",
              false,
            );
          }
        } catch {
          setStatus(
            "Erreur réseau. Vérifiez votre connexion et réessayez.",
            false,
          );
        } finally {
          submitBtn?.removeAttribute("disabled");
        }
      });
    }
  </script>

  <!-- FAQ -->
  <Faq />

  <!-- Call to Action -->
  <CallToAction />
</Base>

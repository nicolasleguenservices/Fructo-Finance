---
import Base from "@/layouts/Base.astro";
import Breadcrumb from "@/layouts/components/Breadcrumb.astro";
import BlogCard from "@/layouts/components/BlogCard.astro";
import CallToAction from "@/layouts/components/CallToAction.astro";
import config from "@/config/config.json";
import { getListPage, getSinglePage } from "@/lib/contentParser.astro";
import frenchDate from "@/lib/utils/frenchDate";
import readingTime from "@/lib/utils/readingTime";
import { getAuthor } from "@/data/authors";

const blogIndex = await getListPage("blogIndex", "-index");
const pageData = blogIndex.data;

const posts = (await getSinglePage("blog")).sort(
  (a, b) =>
    b.data.datePublished.valueOf() - a.data.datePublished.valueOf(),
);

const pillarMeta = {
  investir: { label: "Investir", url: "/investir" },
  "cartes-credit": { label: "Cartes de crédit", url: "/cartes-credit" },
  epargne: { label: "Épargne", url: "/epargne" },
} as const;

const canonical = `${config.site.base_url}/blog`;
---

<Base
  title={pageData.meta_title ?? pageData.title}
  meta_title={pageData.meta_title ?? pageData.title}
  description={pageData.description}
  canonical={canonical}
>
  <section class="section-ph pt-16 md:pt-20 pb-12">
    <div class="container">
      <Breadcrumb items={[{ name: "Accueil", url: "/" }, { name: "Blog" }]} />
      <h1 class="mb-4 max-w-3xl text-h3-sm md:text-h1 text-secondary">
        {pageData.page_header?.title ?? pageData.title}
      </h1>
      <p class="max-w-2xl text-lg text-text-dark">{pageData.description}</p>
    </div>
  </section>

  <section class="section pt-0">
    <div class="container">
      {
        posts.length === 0 ? (
          <p class="text-text-dark">Aucun article pour le moment.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            {posts.map((post) => {
              const d = post.data;
              const author = getAuthor(d.author);
              const pillar = pillarMeta[d.pillar];
              return (
                <BlogCard
                  image={d.coverImage}
                  imageAlt={d.coverAlt}
                  imageFit={d.coverFit}
                  title={d.title}
                  description={d.description}
                  author={author.name}
                  authorImage={author.image}
                  date={frenchDate(d.datePublished)}
                  readTime={readingTime(post.body ?? "")}
                  pillarLabel={pillar.label}
                  pillarUrl={pillar.url}
                  href={`/blog/${d.slug ?? post.id}`}
                />
              );
            })}
          </div>
        )
      }
    </div>
  </section>

  <CallToAction />
</Base>
